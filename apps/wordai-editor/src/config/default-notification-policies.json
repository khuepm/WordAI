{
  "schemaVersion": 1,
  "policies": [
    {
      "id": "sync-status-elapsed",
      "bundle": "sync",
      "sourceKey": "sync.success",
      "channel": "statusBar",
      "format": "elapsed",
      "priority": "low",
      "duration": null,
      "silent": false,
      "trigger": "onEvent",
      "template": "AuraBrain synced · {seconds}s ago",
      "settingId": "general.autoSyncEnabled",
      "description": "Show elapsed time since last AuraBrain sync on status bar"
    },
    {
      "id": "sync-success-brief",
      "bundle": "sync",
      "sourceKey": "sync.success",
      "channel": "statusBar",
      "format": "message",
      "priority": "medium",
      "duration": 2000,
      "silent": false,
      "trigger": "onEvent",
      "template": "✓ AuraBrain synced",
      "settingId": "general.autoSyncEnabled",
      "description": "Brief AuraBrain success indicator on status bar"
    },
    {
      "id": "sync-status-syncing",
      "bundle": "sync",
      "sourceKey": "sync.start",
      "channel": "statusBar",
      "format": "indicator",
      "priority": "medium",
      "duration": null,
      "silent": false,
      "trigger": "onEvent",
      "template": "Syncing AuraBrain…",
      "settingId": "general.autoSyncEnabled",
      "description": "Show AuraBrain syncing indicator on status bar"
    },
    {
      "id": "sync-error-toast",
      "bundle": "sync",
      "sourceKey": "sync.error",
      "channel": "toast",
      "format": "message",
      "priority": "high",
      "duration": 5000,
      "silent": false,
      "trigger": "onEvent",
      "template": "AuraBrain sync failed: {error}",
      "settingId": "general.autoSyncEnabled",
      "description": "Toast notification when AuraBrain sync fails"
    },
    {
      "id": "sync-error-statusbar",
      "bundle": "sync",
      "sourceKey": "sync.error",
      "channel": "statusBar",
      "format": "indicator",
      "priority": "high",
      "duration": null,
      "silent": false,
      "trigger": "onEvent",
      "template": "⚠ AuraBrain sync error",
      "settingId": "general.autoSyncEnabled",
      "description": "Persistent AuraBrain error indicator on status bar"
    },
    {
      "id": "autosave-interval-countdown",
      "bundle": "save",
      "sourceKey": "autoSave.countdown",
      "channel": "statusBar",
      "format": "countdown",
      "priority": "medium",
      "duration": null,
      "silent": false,
      "trigger": "onEvent",
      "template": "Auto-save in {remainingSeconds}s",
      "settingId": "general.autoSave",
      "description": "Countdown to next file auto-save"
    },
    {
      "id": "autosave-success-brief",
      "bundle": "save",
      "sourceKey": "autoSave.success",
      "channel": "statusBar",
      "format": "message",
      "priority": "medium",
      "duration": 2000,
      "silent": false,
      "trigger": "onEvent",
      "template": "✓ File saved",
      "settingId": "general.autoSave",
      "description": "Brief indicator when file is auto-saved"
    },
    {
      "id": "dirty-titlebar-indicator",
      "bundle": "dirty",
      "sourceKey": "document.dirty",
      "channel": "titleBar",
      "format": "indicator",
      "priority": "medium",
      "duration": null,
      "silent": false,
      "trigger": "onEvent",
      "template": "●",
      "settingId": "general.autoSave",
      "description": "Unsaved indicator on title bar"
    },
    {
      "id": "dirty-statusbar",
      "bundle": "dirty",
      "sourceKey": "document.dirty",
      "channel": "statusBar",
      "format": "message",
      "priority": "low",
      "duration": null,
      "silent": false,
      "trigger": "onEvent",
      "template": "Unsaved changes",
      "settingId": "general.autoSave",
      "description": "Unsaved changes text on status bar"
    },
    {
      "id": "preference-change-toast",
      "bundle": "preferences",
      "sourceKey": "preference.*",
      "channel": "toast",
      "format": "message",
      "priority": "low",
      "duration": 2000,
      "silent": true,
      "trigger": "onChange",
      "template": "{label} changed to {newValue}",
      "description": "Toast when any preference changes (disabled by default)"
    },
    {
      "id": "export-success-toast",
      "bundle": "export",
      "sourceKey": "export.complete",
      "channel": "toast",
      "format": "message",
      "priority": "medium",
      "duration": 3000,
      "silent": false,
      "trigger": "onEvent",
      "template": "Exported to {path}",
      "description": "Toast when export completes successfully"
    },
    {
      "id": "export-error-toast",
      "bundle": "export",
      "sourceKey": "export.error",
      "channel": "toast",
      "format": "message",
      "priority": "high",
      "duration": 5000,
      "silent": false,
      "trigger": "onEvent",
      "template": "Export failed: {error}",
      "description": "Toast when export fails"
    },
    {
      "id": "ai-service-unavailable",
      "bundle": "ai",
      "sourceKey": "ai.unavailable",
      "channel": "toast",
      "format": "message",
      "priority": "high",
      "duration": 5000,
      "silent": false,
      "trigger": "onEvent",
      "template": "AI service unavailable. Check connection.",
      "settingId": "ai-engine.agent",
      "description": "Toast when AI service becomes unavailable"
    }
  ]
}
