{
  "schemaVersion": 1,
  "policies": [
    {
      "id": "sync-status-elapsed",
      "bundle": "sync",
      "sourceKey": "sync.success",
      "channel": "statusBar",
      "format": "elapsed",
      "priority": "low",
      "duration": null,
      "silent": false,
      "trigger": "onEvent",
      "template": "Synced · {seconds}s ago",
      "settingId": "general.autoSave",
      "description": "Show elapsed time since last sync on status bar (shows minutes after 60s)"
    },
    {
      "id": "sync-success-brief",
      "bundle": "sync",
      "sourceKey": "sync.success",
      "channel": "statusBar",
      "format": "message",
      "priority": "medium",
      "duration": 2000,
      "silent": false,
      "trigger": "onEvent",
      "template": "✓ Synced",
      "settingId": "general.autoSave",
      "description": "Brief success indicator on status bar (2s, then elapsed takes over)"
    },
    {
      "id": "sync-status-syncing",
      "bundle": "sync",
      "sourceKey": "sync.start",
      "channel": "statusBar",
      "format": "indicator",
      "priority": "medium",
      "duration": null,
      "silent": false,
      "trigger": "onEvent",
      "template": "Syncing...",
      "settingId": "general.autoSave",
      "description": "Show syncing indicator on status bar"
    },
    {
      "id": "sync-error-toast",
      "bundle": "sync",
      "sourceKey": "sync.error",
      "channel": "toast",
      "format": "message",
      "priority": "high",
      "duration": 5000,
      "silent": false,
      "trigger": "onEvent",
      "template": "Sync failed: {error}",
      "settingId": "general.autoSave",
      "description": "Toast notification when sync fails"
    },
    {
      "id": "sync-error-statusbar",
      "bundle": "sync",
      "sourceKey": "sync.error",
      "channel": "statusBar",
      "format": "indicator",
      "priority": "high",
      "duration": null,
      "silent": false,
      "trigger": "onEvent",
      "template": "⚠ Sync error",
      "settingId": "general.autoSave",
      "description": "Persistent error indicator on status bar"
    },
    {
      "id": "autosync-interval-countdown",
      "bundle": "sync",
      "sourceKey": "autoSync.countdown",
      "channel": "statusBar",
      "format": "countdown",
      "priority": "medium",
      "duration": null,
      "silent": false,
      "trigger": "onEvent",
      "template": "Next sync in {remainingSeconds}s",
      "settingId": "general.autoSave",
      "description": "Countdown to next auto-sync (shows 60s before sync)"
    },
    {
      "id": "dirty-titlebar-indicator",
      "bundle": "dirty",
      "sourceKey": "document.dirty",
      "channel": "titleBar",
      "format": "indicator",
      "priority": "medium",
      "duration": null,
      "silent": false,
      "trigger": "onEvent",
      "template": "●",
      "settingId": "general.autoSave",
      "description": "Unsaved indicator on title bar"
    },
    {
      "id": "dirty-statusbar",
      "bundle": "dirty",
      "sourceKey": "document.dirty",
      "channel": "statusBar",
      "format": "message",
      "priority": "low",
      "duration": null,
      "silent": false,
      "trigger": "onEvent",
      "template": "Unsaved changes",
      "settingId": "general.autoSave",
      "description": "Unsaved changes text on status bar"
    },
    {
      "id": "preference-change-toast",
      "bundle": "preferences",
      "sourceKey": "preference.*",
      "channel": "toast",
      "format": "message",
      "priority": "low",
      "duration": 2000,
      "silent": true,
      "trigger": "onChange",
      "template": "{label} changed to {newValue}",
      "description": "Toast when any preference changes (disabled by default)"
    },
    {
      "id": "export-success-toast",
      "bundle": "export",
      "sourceKey": "export.complete",
      "channel": "toast",
      "format": "message",
      "priority": "medium",
      "duration": 3000,
      "silent": false,
      "trigger": "onEvent",
      "template": "Exported to {path}",
      "description": "Toast when export completes successfully"
    },
    {
      "id": "export-error-toast",
      "bundle": "export",
      "sourceKey": "export.error",
      "channel": "toast",
      "format": "message",
      "priority": "high",
      "duration": 5000,
      "silent": false,
      "trigger": "onEvent",
      "template": "Export failed: {error}",
      "description": "Toast when export fails"
    },
    {
      "id": "ai-service-unavailable",
      "bundle": "ai",
      "sourceKey": "ai.unavailable",
      "channel": "toast",
      "format": "message",
      "priority": "high",
      "duration": 5000,
      "silent": false,
      "trigger": "onEvent",
      "template": "AI service unavailable. Check connection.",
      "settingId": "ai-engine.agent",
      "description": "Toast when AI service becomes unavailable"
    }
  ]
}
